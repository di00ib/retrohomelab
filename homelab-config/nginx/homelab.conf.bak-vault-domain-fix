server {
    listen 80;
    server_name firebat.taild1c700.ts.net;
    return 301 https://firebat.taild1c700.ts.net$request_uri;
}
server {
    listen 80;
    server_name 100.73.67.43;
    return 301 https://firebat.taild1c700.ts.net$request_uri;
}
server {
    listen 443 ssl;
    server_name firebat.taild1c700.ts.net;
    client_max_body_size 10G;
    ssl_certificate /etc/nginx/certs/firebat.taild1c700.ts.net.crt;
    ssl_certificate_key /etc/nginx/certs/firebat.taild1c700.ts.net.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    # — HOMEPAGE
    location / {
        proxy_pass http://homepage:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # — NEXTCLOUD
    location = /nextcloud {
        return 301 /nextcloud/;
    }
    location /nextcloud/ {
        proxy_pass http://nextcloud:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 10G;
    }
    # — COLLABORA
    location /collabora {
        proxy_pass http://collabora:9980;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }
    # — VAULTWARDEN
    location /vault/ {
        proxy_pass http://vaultwarden:80/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # — HOME ASSISTANT
    location /homeassistant {
        proxy_pass http://homeassistant:8123;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
    # — FRIGATE
    location /frigate {
        proxy_pass http://frigate:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
    # — CODE-SERVER
    location /code {
        proxy_pass http://code-server:8443;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
    # — JUPYTER
    location /jupyter {
        proxy_pass http://jupyter:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
    # — PORTAINER
    location /portainer/ {
        proxy_pass http://portainer:9000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
    # — RETRO-SERVER
    location /apps {
        proxy_pass http://retro-server:7845;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    # - HEART JOURNAL
    location /heartjournal/ {
        proxy_pass http://heartjournal-api:5757/heartjournal/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type";
    }
    # — PLEX (host network mode; not on the homelab bridge network)
    location = /plex {
        return 301 /plex/;
    }
    location /plex/ {
        proxy_pass http://host.docker.internal:32400/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;

        proxy_set_header X-Plex-Client-Identifier plex-nginx;
        proxy_set_header Accept-Encoding "";
        proxy_cookie_path / /plex/;

        sub_filter_once off;
        sub_filter_types text/html application/javascript application/json;
        sub_filter 'href="/' 'href="/plex/';
        sub_filter 'src="/' 'src="/plex/';
        sub_filter '"/web' '"/plex/web';
    }
}
