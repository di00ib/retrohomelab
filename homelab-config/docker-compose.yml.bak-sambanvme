networks:
  homelab:
    driver: bridge

services:

  nginx:
    image: nginx:alpine
    container_name: nginx
    restart: unless-stopped
    networks: [homelab]
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/homelab.conf:/etc/nginx/conf.d/default.conf:r
      - /etc/nginx/certs:/etc/nginx/certs:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - homepage
      - nextcloud
      - vaultwarden
      - homeassistant
      - code-server
      - jupyter
      - portainer
      - retro-server

  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    restart: unless-stopped
    networks: [homelab]
    environment:
      HOMEPAGE_ALLOWED_HOSTS: 100.73.67.43
    volumes:
      - ./homepage:/app/config
      - /var/run/docker.sock:/var/run/docker.sock:ro

  nextcloud-db:
    image: mariadb:11
    container_name: nextcloud-db
    restart: unless-stopped
    networks: [homelab]
    environment:
      MYSQL_ROOT_PASSWORD: ${NC_ROOT_PASS}
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: ${NC_DB_PASS}
    volumes:
      - nextcloud-db:/var/lib/mysql

  nextcloud:
    image: nextcloud:28
    container_name: nextcloud
    restart: unless-stopped
    networks: [homelab]
    depends_on: [nextcloud-db]
    environment:
      MYSQL_HOST: nextcloud-db
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: ${NC_DB_PASS}
      NEXTCLOUD_ADMIN_USER: admin
      NEXTCLOUD_ADMIN_PASSWORD: ${NC_ADMIN_PASS}
      NEXTCLOUD_TRUSTED_DOMAINS: ${TAILSCALE_IP}
      PHP_MEMORY_LIMIT: 1G
      PHP_UPLOAD_LIMIT: 10G
      TZ: ${TZ}
    volumes:
      - nextcloud-app:/var/www/html
      - /mnt/pool/nextcloud-data:/var/www/html/data

  collabora:
    image: collabora/code:latest
    container_name: collabora
    restart: unless-stopped
    networks: [homelab]
    environment:
      aliasgroup1: http://${TAILSCALE_IP}
      DONT_GEN_SSL_CERT: "YES"
      extra_params: "--o:ssl.enable=false --o:ssl.termination=true"
      TZ: ${TZ}
    cap_add:
      - MKNOD

  plex:
    image: lscr.io/linuxserver/plex:latest
    container_name: plex
    restart: unless-stopped
    network_mode: host
    environment:
      PLEX_CLAIM: "claim-RGNS_UUKSwheoBGTeBXr"
      PUID: 1000
      PGID: 1000
      TZ: ${TZ}
      VERSION: docker
    volumes:
      - plex-config:/config
      - /mnt/pool/Plex:/plex
    devices:
      - /dev/dri:/dev/dri

  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    restart: unless-stopped
    networks: [homelab]
    environment:
      ADMIN_TOKEN: ${VAULT_ADMIN_TOKEN}
      DOMAIN: https://firebat.taild1c700.ts.net/vault
      WEBSOCKET_ENABLED: "true"
      TZ: ${TZ}
    volumes:
      - vaultwarden-data:/data

  homeassistant:
    image: ghcr.io/home-assistant/home-assistant:stable
    container_name: homeassistant
    restart: unless-stopped
    networks: [homelab]
    privileged: true
    environment:
      TZ: ${TZ}
    volumes:
      - /mnt/pool/homeassistant:/config
      - /etc/localtime:/etc/localtime:ro

  frigate:
    image: ghcr.io/blakeblackshear/frigate:stable
    container_name: frigate
    restart: unless-stopped
    networks: [homelab]
    privileged: true
    environment:
      TZ: ${TZ}
    volumes:
      - ./frigate/config.yml:/config/config.yml:ro
      - /mnt/pool/frigate-recordings:/media/frigate
      - /etc/localtime:/etc/localtime:ro
    shm_size: "256mb"

  samba:
    image: dperson/samba:latest
    ports:
      - "445:445"
      - "139:139"
      - "137:137/udp"
      - "138:138/udp"
    container_name: samba
    security_opt:
      - apparmor:unconfined
    restart: unless-stopped
    networks: [homelab]
    environment:
      TZ: ${TZ}
    command: >
      -u "${SAMBA_USER};${SAMBA_PASS}"
      -s "pool;/mnt/pool;yes;no;no;${SAMBA_USER}"
      -s "homelab;/home/di0__0ib/homelab;yes;no;no;${SAMBA_USER}"
    volumes:
      - /home/di0__0ib/homelab-docs:/homelab-docs
      - /mnt/pool/shared:/mnt/pool/shared
      - /mnt/pool/media:/mnt/pool/media
      - /mnt/pool:/mnt/pool
      - /home/di0__0ib:/home/di0__0ib
      - /mnt/exos26tb:/exos26tb
      - /mnt/nvme1tb:/mnt/nvme1tb
      - /mnt/pool/24tb-recovered:/mnt/pool/24tb-recovered
      - /mnt/pool/frigate-recordings:/mnt/pool/frigate-recordings
      - /mnt/pool/game-installers:/mnt/pool/game-installers
      - /mnt/pool/guitar-recordings:/mnt/pool/guitar-recordings
      - /mnt/pool/homeassistant:/mnt/pool/homeassistant
      - /mnt/pool/immich-photos:/mnt/pool/immich-photos
      - /mnt/pool/j4.5-backup:/mnt/pool/j4.5-backup
      - /mnt/pool/nextcloud-data:/mnt/pool/nextcloud-data
      - /mnt/pool/recovered:/mnt/pool/recovered
      - /mnt/pool/retro-apps:/mnt/pool/retro-apps
  code-server:
    image: lscr.io/linuxserver/code-server:latest
    container_name: code-server
    restart: unless-stopped
    networks: [homelab]
    environment:
      PUID: 1000
      PGID: 1000
      TZ: ${TZ}
      PASSWORD: ${CODE_PASSWORD}
      DEFAULT_WORKSPACE: /home/coder/retro-apps
    volumes:
      - code-server-config:/config
      - /mnt/pool/retro-apps:/home/coder/retro-apps

  jupyter:
    image: jupyter/scipy-notebook:latest
    container_name: jupyter
    restart: unless-stopped
    networks: [homelab]
    environment:
      JUPYTER_TOKEN: ${JUPYTER_TOKEN}
      TZ: ${TZ}
    volumes:
      - jupyter-data:/home/jovyan/work

  portainer:
    image: portainer/portainer-ce:latest
    container_name: portainer
    restart: unless-stopped
    networks: [homelab]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer-data:/data

  retro-server:
    image: node:20-alpine
    container_name: retro-server
    restart: unless-stopped
    networks: [homelab]
    working_dir: /app
    command: node retro-server.js
    environment:
      PORT: "7845"
      APPS_DIR: /apps
      API_KEY: ${RETRO_API_KEY}
    volumes:
      - /mnt/nvme1tb/retro-apps:/apps
      - ./retro-server.js:/app/retro-server.js:ro
      - ./logs:/logs

  adguardhome:
    image: adguard/adguardhome:latest
    container_name: adguardhome
    restart: unless-stopped
    networks: [homelab]
    environment:
      TZ: America/Indiana/Indianapolis
    ports:
      - "53:53/tcp"
      - "53:53/udp"
      - "3010:3000/tcp"
    volumes:
      - adguardhome-work:/opt/adguardhome/work
      - adguardhome-conf:/opt/adguardhome/conf
  dnd-saves-api:
    image: node:20-alpine
    container_name: dnd-saves-api
    restart: unless-stopped
    networks: [homelab]
    working_dir: /app
    command: node server.js
    environment:
      PORT: "7846"
      DATA_DIR: /data
      API_KEY: ${DND_SAVES_API_KEY}
    ports:
      - "7846:7846"
    volumes:
      - ./dnd-saves-api/server.js:/app/server.js:ro
      - /mnt/nvme1tb/dnd-saves-data:/data

  dnd-app-host:
    image: nginx:alpine
    container_name: dnd-app-host
    restart: unless-stopped
    networks: [homelab]
    ports:
      - "7847:80"
    volumes:
      - /mnt/nvme1tb/retro-apps:/usr/share/nginx/html:ro

volumes:
  adguardhome-work:
  adguardhome-conf:
  nextcloud-db:
  nextcloud-app:
  plex-config:
  vaultwarden-data:
  code-server-config:
  jupyter-data:
  portainer-data:
